# ── Streamlit Secrets Example for Eco-Tide ──────────────────────────────────
# For Local Development:
#   Rename this file to `secrets.toml` inside the `.streamlit/` directory:
#   .streamlit/secrets.toml
#
# For Streamlit Community Cloud:
#   Paste these contents into "Settings" -> "Secrets" in your app's dashboard.

# 1. Supabase PostgreSQL Connection String (Pooler or Direct)
DATABASE_URL = "postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres"

# 2. Supabase API Configuration (Optional / REST)
SUPABASE_URL = "https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY = "[YOUR-SUPABASE-ANON-KEY]"

# 3. Dedicated PostgreSQL parameters block
[postgres]
host = "aws-1-eu-central-1.pooler.supabase.com"
port = 6543
dbname = "postgres"
user = "postgres.[PROJECT-REF]"
password = "[YOUR-PASSWORD]"
sslmode = "require"
